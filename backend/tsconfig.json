{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,  // <--- Añade esta línea para ignorar errores de tipos en node_modules
    "outDir": "dist",
    "rootDir": "src"
  }
}

